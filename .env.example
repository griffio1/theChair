# Copy to web/.env.local and fill in. Never commit local environment files.

# Supabase (Builder A)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Main chat LLM: groq | gemini | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Extractor (Builder B)
EXTRACTOR=auto
GEMINI_API_KEY=
# Check Google's model list for the current Flash name before the event.
GEMINI_MODEL=gemini-flash-latest

# GitHub
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_WEBHOOK_SECRET=

# Where the MCP server and hook reach the API
THECHAIR_API_URL=http://localhost:3000
THECHAIR_DEVELOPER=
THECHAIR_AGENT=claude-code
# Private agent credential registered by web/scripts/configure-agent.ts.
# Never prefix this with NEXT_PUBLIC_. Add it to the MCP launcher and hook environment.
THECHAIR_AGENT_TOKEN=

# Optional canonical public site for shared invitation and webhook URLs.
THECHAIR_PUBLIC_URL=
