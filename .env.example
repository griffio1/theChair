# Copy to .env and fill in. Never commit .env.

# Supabase (Builder A)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Main chat LLM: groq | gemini | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Extractor (Builder B)
GEMINI_API_KEY=
# Check Google's model list for the current Flash name before the event.
GEMINI_MODEL=gemini-flash-latest

# GitHub
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_WEBHOOK_SECRET=

# Where the MCP server and hook reach the API
AGENTSYNC_API_URL=http://localhost:3000
AGENTSYNC_DEVELOPER=
AGENTSYNC_AGENT=claude-code
