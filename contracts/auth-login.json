{
  "id": "auth-login",
  "name": "Login",
  "path": "/api/auth/login",
  "notes": "camelCase for all JSON fields.",
  "owner": "parag",
  "method": "POST",
  "status": "approved",
  "request": [
    {
      "name": "email",
      "type": "string",
      "required": true
    },
    {
      "name": "password",
      "type": "string",
      "required": true
    }
  ],
  "version": 1,
  "response": [
    {
      "name": "userId",
      "type": "string",
      "required": true
    },
    {
      "name": "token",
      "type": "string",
      "required": true
    }
  ]
}
