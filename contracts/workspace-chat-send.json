{
  "id": "workspace-chat-send",
  "name": "Send a workspace message with optional images",
  "method": "POST",
  "path": "/api/workspaces/:workspaceId/chats/:chatId/messages",
  "request": [
    {
      "name": "body",
      "type": "string",
      "required": true
    },
    {
      "name": "clientMessageId",
      "type": "string",
      "required": true
    },
    {
      "name": "imageIds",
      "type": "array",
      "required": false
    }
  ],
  "response": [
    {
      "name": "messages",
      "type": "array",
      "required": true
    }
  ],
  "version": 2,
  "status": "approved",
  "owner": "carter"
}
